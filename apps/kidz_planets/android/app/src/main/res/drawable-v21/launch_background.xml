<?xml version="1.0" encoding="utf-8"?>
<!-- Planetaria launch splash (API 21+): same artwork as the base drawable so
     cold start looks identical on every OS version. Previously this variant
     used ?android:colorBackground (near-white), which flashed light before
     the dark Flutter intro painted. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/planetaria_mark" />
    </item>
</layer-list>
