# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/apps/*/android/app/debug
/apps/*/android/app/profile
/apps/*/android/app/release

# Widget Preview related
.widget_preview/

# Kokoro neural narration generation (local-only tooling)
.venv-kokoro/
__pycache__/
*.pyo
*.wav
!assets/audio/sfx/**/*.wav
# SFX may be committed as MP3; the narration below is tracked as-is, so only
# the SFX tree gets a whitelist entry.
!assets/audio/sfx/**/*.mp3
.kokoro/
*.pth
*.pt
*.safetensors
# pyenv pins the local interpreter; it is machine-specific, not project config.
.python-version

# Generated by flutter gen-l10n (see apps/kidz_planets/l10n.yaml); regenerate
# with `melos run gen`.
apps/kidz_planets/lib/l10n/generated/

# Compiled by the flutter_scene build hook into the app's generated asset tree.
flutter_scene_generated/

# Melos writes path-based dependency pins here.
melos_*.iml
pubspec_overrides.yaml
**/pubspec_overrides.yaml
